# Токен бота от @BotFather
BOT_TOKEN=

# Твой Telegram ID: владелец может менять прокси командой /proxy
ADMIN_ID=

# Telegram ID друзей через запятую. Пусто — бот открыт для всех.
# Узнать ID: напиши боту — если тебя нет в списке, он покажет твой ID.
ALLOWED_USERS=

# ---------- Нейросеть ----------
# claude — Claude API (платно, умнее)
# openai — любой OpenAI-совместимый API, в том числе бесплатный (OpenRouter, Groq и др.)
AI_PROVIDER=openai

# Для AI_PROVIDER=claude: ключ с https://platform.claude.com
ANTHROPIC_API_KEY=
# claude-opus-5-5 (умнее) или claude-haiku-5-5 (примерно в 40 раз дешевле)
CLAUDE_MODEL=claude-opus-5-5

# Для AI_PROVIDER=openai. По умолчанию — бесплатные модели OpenRouter (ключ: https://openrouter.ai/keys)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
# Можно несколько через запятую: если первая недоступна, бот попробует следующую.
# Список бесплатных моделей: https://openrouter.ai/models?q=free
OPENAI_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,minimax/minimax-m3.1-flash:free,openrouter/free
# Пример для Groq (ключ: https://console.groq.com/keys):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-120b

# Сколько запросов к нейросети в день можно одному человеку
AI_DAILY_LIMIT=15

# ---------- Прочее ----------
# Часовой пояс для напоминаний
TIMEZONE=Europe/Moscow

# Прокси для запросов к нейросети (http://, https://, socks5://).
# Удобнее менять прямо в боте командой /proxy.
PROXY_URL=
